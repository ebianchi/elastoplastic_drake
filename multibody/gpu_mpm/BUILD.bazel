# -*- mode: python -*-
# vi: set ft=python :

load(
    "//tools/skylark:cuda.bzl",
    "nvcc_library",
)

load(
    "//tools/skylark:drake_cc.bzl",
    "drake_cc_googletest",
    "drake_cc_library",
    "drake_installed_headers",
)

package(
    default_visibility = ["//visibility:public"],
)

nvcc_library(
    name = "cuda_mpm",
    hdrs = ["settings.h", 
            "blelloch_scan.cuh", 
            "radix_sort.cuh",
            "sifakis_svd.cuh",
            "math_tools.cuh",
            "cuda_mpm_kernels.cuh", 
            "cuda_mpm_model.cuh",
            "cuda_mpm_solver.cuh",
            "tph_poisson.h",
            "cpu_mpm_model.h",
            ],
    srcs = ["blelloch_scan.cu", 
            "cuda_mpm_model.cu",
            "cuda_mpm_solver.cu",
            "tph_poisson.cu",
            ],
    deps = [
        "//common:essential",
    ],
)

# Provide an "installed_headers" target so higher-level drake build macros
# that expect a <name>.installed_headers dependency can find these headers.
drake_installed_headers(
    name = "cuda_mpm.installed_headers",
    hdrs = [
        "settings.h",
        "blelloch_scan.cuh",
        "radix_sort.cuh",
        "sifakis_svd.cuh",
        "math_tools.cuh",
        "cuda_mpm_kernels.cuh",
        "cuda_mpm_model.cuh",
        "cuda_mpm_solver.cuh",
        "tph_poisson.h",
        "cpu_mpm_model.h",
    ],
    # No Drake deps for these headers; provide an empty deps list so the
    # drake_installed_headers rule produces the DrakeCc provider expected by
    # downstream drake_installed_headers consumers.
    deps = [],
    visibility = ["//visibility:public"],
)
