<?xml version="1.0" encoding="utf-8"?>
<robot name="ground">
  <link name="ground">
    <inertial>
      <mass value="1"/>
      <inertia ixx="100"  ixy="0"  ixz="0" iyy="100" iyz="0" izz="100" />
    </inertial>
    <visual>
      <origin xyz="0.25 0.25 0.05" />
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
      <material>
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>

    <collision name="ground">
      <origin xyz="0.25 0.25 0.05" />
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
      <drake:proximity_properties>
        <drake:mesh_resolution_hint value="0.01"/>
        <drake:mu_static value="1"/>
        <drake:mu_dynamic value="1"/>
      </drake:proximity_properties>
    </collision>
  </link>

</robot>
